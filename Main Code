int main()
{
    char st[50], si[20], wa[20],cr[100];
    char *selectedCrop;
    int choice;
    printf("===== AGRISMART =====\n");
    printf("Enter State: ");
    scanf("%s", st);
    printf("Enter Season (Winter/Summer/Spring): ");
    scanf("%s", si);
    printf("Water Availability (Low/Medium/High): ");
    scanf("%s", wa);
    selectCrops(si, wa, cr);
    printf("\n===== RECOMMENDED CROPS =====\n");
    displayCrops(cr, 0);

    printf("\nSelect your crop: ");
    scanf("%d", &choice);

    if (choice < 1 || choice > 5)
    {
        printf("Invalid choice!");
        return 0;
    }

    selectedCrop = &cr[(choice - 1) * 20];

    printf("\n===== SELECTED CROP DETAILS =====\n");

    printf("State: %s\n", st);
    printf("Selected Crop: %s\n", selectedCrop);

    cropDetails(choice);
    printf("Thanks for consulting!");
    return 0;
}
