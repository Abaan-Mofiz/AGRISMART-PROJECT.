#include <stdio.h>
#include <string.h>
void selectCrops(char si[], char wa[], char cr[])
{
 if (strcmp(si, "Winter") == 0){
    if (strcmp(wa, "Low") == 0){
      strcpy(&cr[0], "Mustard");
      strcpy(&cr[20], "Gram");
      strcpy(&cr[40], "Lentil");
      strcpy(&cr[60], "Peas");
      strcpy(&cr[80], "Barley");
        }
        else{
            strcpy(&cr[0], "Wheat");
            strcpy(&cr[20], "Potato");
            strcpy(&cr[40], "Peas");
            strcpy(&cr[60], "Mustard");
            strcpy(&cr[80], "Gram");
        }
    }
    else if (strcmp(si, "Summer") == 0)
    {
        if (strcmp(wa, "Low") == 0)
        {
            strcpy(&cr[0], "Millet");
            strcpy(&cr[20], "Moong");
            strcpy(&cr[40], "Cowpea");
            strcpy(&cr[60], "Groundnut");
            strcpy(&cr[80], "Sesame");
        }
        else
        {
            strcpy(&cr[0], "Maize");
            strcpy(&cr[20], "Rice");
            strcpy(&cr[40], "Tomato");
            strcpy(&cr[60], "Cucumber");
            strcpy(&cr[80], "Watermelon");
        }
    }
    else
    {
        strcpy(&cr[0], "Maize");
        strcpy(&cr[20], "Potato");
        strcpy(&cr[40], "Tomato");
        strcpy(&cr[60], "Moong");
        strcpy(&cr[80], "Vegetables");
    }
}
void displayCrops(char cr[], int i)
{
    if (i == 5)
        return;

    printf("%d. %s\n", i + 1, &cr[i * 20]);

    displayCrops(cr, i + 1);
}
